# syntax=docker/dockerfile:1.7
# ============================================================================
# Life OS v3 — образ статики: multi-stage node:24-alpine → nginx (unprivileged).
#
# СТАТУС: не собрано и не запущено — docker в среде нет (MASTER_SPEC §0).
#         Node 24 и npm 11 в среде есть, поэтому шаги npm ci / npm run build
#         взяты из MASTER_SPEC §0.5, но сам образ не проверялся.
#
# Требует app/web (Фаза 5: React + Vite). Пока каталога app/ нет — COPY
# упадёт; это ожидаемо до сдачи Фазы 5.
#
# Почему nginx-unprivileged: образ работает под uid 101 и слушает 8080,
# мастер-процесс не root. Требование «non-root» выполнено без cap_add.
# TLS снаружи делает Caddy, поэтому здесь только HTTP.
#
# Сборка:
#   docker build -f deploy/Dockerfile.web -t lifeos-web:local .
# ============================================================================

# --- Stage 1: сборка SPA -----------------------------------------------------
FROM node:24-alpine AS build

WORKDIR /src

ENV CI=1 \
    NODE_ENV=development

# Манифесты отдельно от кода: слой npm-зависимостей кэшируется, пока не
# изменились package.json / lock-файл.
COPY app/web/package*.json ./

# npm ci требует package-lock.json. Если он не закоммичен — собираем через
# npm install (результат не детерминирован, поэтому лучше держать lock в git).
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    set -eux; \
    if [ -f package-lock.json ]; then \
        npm ci --no-audit --no-fund; \
    else \
        echo "package-lock.json нет — fallback на npm install"; \
        npm install --no-audit --no-fund; \
    fi

# Код приложения — после зависимостей, чтобы правка .tsx не тянула npm заново.
COPY app/web/ ./

RUN set -eux; \
    npm run build; \
    test -f dist/index.html

# --- Stage 2: раздача статики -----------------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# Образ уже содержит пользователя nginx (uid 101) и слушает 8080.
USER 101

COPY --chown=101:101 deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/index.html || exit 1
