# ============================================================================
# Life OS v3 — шаблон переменных окружения.
#
# КАК ПОЛЬЗОВАТЬСЯ
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   $EDITOR deploy/.env          # заполнить плейсхолдеры
#
# deploy/.env в git не попадает (см. .gitignore). Этот шаблон — попадает,
# поэтому здесь только плейсхолдеры, ни одного настоящего секрета.
#
# Комментарий в строке после значения допустим, а вот пробелы вокруг «=»
# и кавычки вокруг значений compose понимает буквально — не добавляйте их.
# Значения с пробелами/кириллицей — в двойных кавычках.
# ============================================================================

# ---------------------------------------------------------------------------
# ВАЖНО: имена переменных существуют в двух наборах, и это не опечатка.
#
#   .env / ТЗ / docker-compose        приложение (app/server/settings.py)
#   --------------------------------  --------------------------------------
#   TELEGRAM_BOT_TOKEN            ->  LIFEOS_TELEGRAM_TOKEN
#   ADMIN_TELEGRAM_ID             ->  LIFEOS_ADMIN_TELEGRAM_ID
#   LIFEOS_VAULT_DIR              ->  LIFEOS_VAULT
#   LIFEOS_TZ                     ->  LIFEOS_TZ
#   LIFEOS_DATA_DIR / MEDIA_DIR   ->  те же имена
#   LIFEOS_DB_PATH                ->  то же имя
#
# compose (блок x-lifeos-common-env) передаёт ОБА имени, поэтому в контейнере
# работают и короткие, и LIFEOS_*. Заполнять .env нужно по левой колонке.
# Когда Фаза 4 зафиксирует номенклатуру, дубли можно убрать.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. Домен и HTTPS (путь А — VPS; для пути Б см. DEPLOY_GUIDE §2)
# ---------------------------------------------------------------------------
# Домен, на который указывает A-запись (и AAAA, если есть IPv6).
# Caddy выпустит сертификат Let's Encrypt автоматически при первом старте,
# поэтому DNS должен уже работать: проверьте `dig +short lifeos.example.ru`.
LIFEOS_DOMAIN=lifeos.example.ru

# Контакт для Let's Encrypt: письма об истечении сертификата.
ACME_EMAIL=you@example.ru

# Тег образов. Меняйте при обновлении (например, 2026-11-17), чтобы был
# откат: docker compose ... up -d с прежним тегом (DEPLOY_GUIDE §6).
LIFEOS_TAG=local

# ---------------------------------------------------------------------------
# 2. Доступ владельца (MASTER_SPEC §2.6)
# ---------------------------------------------------------------------------
# Токен владельца: один секрет на всё — cookie в браузере и заголовок
# X-LifeOS-Token для API. Сгенерировать:
#   openssl rand -hex 32
# Требования: минимум 32 символа, без пробелов. Сменить = разлогинить все
# устройства (это и есть «выйти везде»).
LIFEOS_TOKEN=CHANGE_ME_openssl_rand_hex_32

# Ваш Telegram user id (не username). Узнать: написать @userinfobot.
# Единственный, кому бот отвечает (whitelist, MASTER_SPEC §2.3).
ADMIN_TELEGRAM_ID=123456789

# ---------------------------------------------------------------------------
# 3. Telegram
# ---------------------------------------------------------------------------
# Токен от @BotFather. Формат: 123456789:AA... — ровно как выдал BotFather.
TELEGRAM_BOT_TOKEN=123456789:CHANGE_ME

# api_id/api_hash с my.telegram.org → API development tools.
# Нужны ТОЛЬКО локальному Bot API Server (сервис telegram-bot-api):
# он поднимает собственный сервер этого типа и без пары не стартует.
# Эти же значения НЕ путать с токеном бота.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=CHANGE_ME_32_hex_chars

# Куда ходит бот/API за Telegram.
#   путь А (docker):  http://telegram-bot-api:8081  — задаётся в compose
#   путь Б (systemd): http://127.0.0.1:8081, если Bot API Server поднят
#                     локально; иначе https://api.telegram.org
# При пустом значении используется облачный api.telegram.org (лимит 20 МБ).
TELEGRAM_API_BASE=http://127.0.0.1:8081

# ---------------------------------------------------------------------------
# 4. Пути к данным (внутри контейнеров — фиксированы compose; эти значения
#    нужны для systemd-варианта и для bind-mount'ов на хосте)
# ---------------------------------------------------------------------------
LIFEOS_DATA_DIR=/srv/lifeos/data
LIFEOS_MEDIA_DIR=/srv/lifeos/media
LIFEOS_VAULT_DIR=/srv/lifeos/vault

# Писать ли в Obsidian-базу (false = только БД, база не трогается).
# Полезно на время отладки: заметки не засоряются тестовыми записями.
LIFEOS_VAULT_WRITE=true

# Obsidian-база на хосте (macOS-путь в примере). Используется, если вы
# заменили именованный том vault на bind-mount (DEPLOY_GUIDE §4):
#   - ${OBSIDIAN_VAULT_PATH}:/srv/lifeos/vault
# Путь с пробелами и кириллицей — в кавычках.
OBSIDIAN_VAULT_PATH="/Users/you/Documents/Obsidian/Мой vault"

# ---------------------------------------------------------------------------
# 5. Часовой пояс и язык
# ---------------------------------------------------------------------------
# Влияет на «сегодня» в журнале, расписание утренних/вечерних вопросов
# и границы суток в аналитике. IANA-имя, не смещение.
LIFEOS_TZ=Europe/Moscow

# ---------------------------------------------------------------------------
# 6. LLM (необязательно: без ключа бот работает в fallback-режиме)
# ---------------------------------------------------------------------------
# Включить LLM-разбор свободного текста. false = всё пишется как есть,
# без структурирования (данные не теряются).
LIFEOS_LLM_ENABLED=true

# Любой OpenAI-совместимый /v1/chat/completions. Пусто = без LLM.
LIFEOS_LLM_BASE_URL=https://api.example.com/v1
LIFEOS_LLM_MODEL=deepseek-v4.1-flash-1017
LIFEOS_LLM_API_KEY=CHANGE_ME_or_leave_empty

# ---------------------------------------------------------------------------
# 7. Транскрибация (MASTER_SPEC §0.2: без toolchain — статус pending_toolchain)
# ---------------------------------------------------------------------------
# faster-whisper ставится в образ ТОЛЬКО при сборке с WITH_WHISPER=true
# (образ +~1.2 ГБ, сборка 5–10 мин). false = NullTranscriber, честный
# статус в UI «нужен ffmpeg/whisper».
WITH_WHISPER=false

# Размер модели: tiny | base | small | medium | large-v3.
# small ≈ 500 МБ, medium ≈ 1.5 ГБ, large-v3 ≈ 3 ГБ (в кэш на диске).
WHISPER_MODEL=small

# Где искать бинарь ffmpeg (в контейнере с WITH_WHISPER он уже в PATH).
FFMPEG_BIN=ffmpeg

# ---------------------------------------------------------------------------
# 8. Лимиты загрузки (Caddy, deploy/Caddyfile)
# ---------------------------------------------------------------------------
# Максимальный размер тела запроса под видео/аудио курсов. Caddy понимает
# суффиксы KB/MB/GB. Всё, что не похоже на медиа, ограничено 8 МБ в Caddyfile.
MEDIA_MAX_UPLOAD=2GB

# ---------------------------------------------------------------------------
# 9. Бэкапы (используются в DEPLOY_GUIDE §5, не в compose)
# ---------------------------------------------------------------------------
# Куда складывать архивы: внешний диск, сетевой каталог, rclone-ремоут.
BACKUP_DIR=/Volumes/Backup/lifeos
# Сколько последних архивов держать (остальные удаляются скриптом бэкапа).
BACKUP_KEEP=14
