<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Шаблон LaunchAgent для Life OS.
  install.sh подставляет вместо __APP_DIR__ и __LOG_DIR__ реальные пути:
    __APP_DIR__ → ~/Library/Application Support/LifeOS
    __LOG_DIR__ → ~/Library/Logs/LifeOS
  Не редактируй этот файл: правится config.json, после чего install.sh с флагом reload.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lifeos.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>src/main.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__APP_DIR__</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- KeepAlive{SuccessfulExit:false}: перезапускать только после падения.
	     Чистое завершение (например, не заполнен токен — код 0) не должно
	     крутить цикл перезапусков и засорять лог. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<!-- Права «только владельцу»: 63 = 0o077. Файлы процесса (БД, логи,
	     дашборд) создаются 0600, каталоги 0700 — launchd применяет umask
	     к своему процессу, поэтому это работает даже без правок в коде. -->
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/agent.out.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/agent.out.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
