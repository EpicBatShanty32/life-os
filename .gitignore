# ============================================================================
# Life OS — что НЕ коммитим.
# Правило: в git попадает только код, шаблоны и документация.
# Всё личное (токены, база, логи) и всё сгенерированное — остаётся на диске.
# ============================================================================

# --- Секреты -----------------------------------------------------------------
# Личный конфиг: токен бота, chat_id, ключ LLM. Рядом лежит безопасный
# config/config.example.json — он в git и должен оставаться с пустыми полями.
config/config.json

# --- Деплой ------------------------------------------------------------------
# deploy/.env — реальные секреты (токен бота, LIFEOS_TOKEN, API_ID/HASH).
# В git живёт только шаблон deploy/.env.example с плейсхолдерами.
deploy/.env
data/telegram-bot-api/

# --- Данные приложения -------------------------------------------------------
# SQLite (lifeos.db), pid-файл, логи, очередь недописанных записей.
data/

# --- Сгенерированные страницы дашборда --------------------------------------
# Собираются автоматически при каждой новой записи (src/dashboard_data.py).
# В git — только dashboard/template.html (исходник дизайна).
dashboard/index.html
dashboard/data.json

# --- Демо-дашборд ------------------------------------------------------------
# Собран из демо-данных для показа пользователю; пересобирается за минуту.
demo/index.html
demo/data.json

# --- Python ------------------------------------------------------------------
__pycache__/
*.pyc

# --- Временные файлы тестов --------------------------------------------------
tests/tmp/

# --- Мусор системы -----------------------------------------------------------
*.log
.DS_Store
