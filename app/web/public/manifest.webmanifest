{
  "name": "Life OS",
  "short_name": "Life OS",
  "description": "Дневник, сон, тренировки и курсы в одном экране",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F6F7FB",
  "theme_color": "#F6F7FB",
  "categories": ["health", "lifestyle", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Сегодня", "url": "./#/today", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Журнал", "url": "./#/journal", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Курсы", "url": "./#/courses", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
